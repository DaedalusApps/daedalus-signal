# DaedalusSignal Backend Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Security
# ===================
SECRET_KEY=your-super-secret-key-change-this-in-production

# ===================
# Admin Account
# ===================
# Admin panel: /dashboard/admin
ADMIN_EMAIL=admin@daedalusapps.com
ADMIN_PASSWORD=change-this-password

# ===================
# Database
# ===================
# SQLite (default, for local development)
# DATABASE_URL=sqlite:///path/to/your/database.db

# MySQL (for PythonAnywhere)
# DATABASE_URL=mysql://username:password@username.mysql.pythonanywhere-services.com/username$daedalus

# ===================
# Email Configuration
# ===================
# Set to "smtp" to enable real email sending, "console" for dev testing
EMAIL_MODE=console

# SMTP Settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@daedalusapps.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@daedalusapps.com

# ===================
# Cloudflare Turnstile (CAPTCHA)
# ===================
# Get keys from: https://dash.cloudflare.com/turnstile
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ===================
# Worker Authentication (DreamHost Workers)
# ===================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# WORKER_SECRET=your-64-character-secret

# Your PA app's public URL (used for unsubscribe links and worker callbacks)
# PA_API_URL=https://your-username.pythonanywhere.com

# ===================
# CORS (Cross-Origin Resource Sharing)
# ===================
# Add your frontend domain(s) here for production
CORS_ORIGIN_1=https://signal.daedalusapps.com
# CORS_ORIGIN_2=https://another-frontend.com