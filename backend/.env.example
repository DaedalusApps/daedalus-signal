# DaedalusSignal Backend Environment Variables
# Copy this file to .env and fill in your values

# ===================
# Security
# ===================
SECRET_KEY=your-super-secret-key-change-this-in-production

# ===================
# Admin Account
# ===================
# Admin panel: /dashboard/admin
ADMIN_EMAIL=admin@daedalusapps.com
ADMIN_PASSWORD=change-this-password

# ===================
# Email Configuration (DreamHost SMTP)
# ===================
# Set to "smtp" to enable real email sending, "console" for dev testing
EMAIL_MODE=console

# DreamHost SMTP Settings
SMTP_HOST=mail.daedalusapps.com
SMTP_PORT=587
SMTP_USER=noreply@daedalusapps.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@daedalusapps.com

# ===================
# Database (optional, defaults to ./data/daedalus.db)
# ===================
# DATABASE_URL=sqlite:///path/to/your/database.db