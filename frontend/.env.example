# DaedalusSignal Frontend Environment Variables
# Copy this file to .env.local for local development
# Copy this file to .env.production for production builds

# ===================
# API Configuration
# ===================
# Base URL of the PHP API (see DEPLOYMENT.md)
NEXT_PUBLIC_API_URL=https://your-api-domain.com

# ===================
# Cloudflare Turnstile (CAPTCHA)
# ===================
# Get keys from: https://dash.cloudflare.com/turnstile
# Site key is used on the frontend, secret key is used on the backend
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ===================
# DreamHost Worker (Optional)
# ===================
# URL of worker/web_shim.php, used to send test emails from the admin
# dashboard. Leave empty to disable that feature.
NEXT_PUBLIC_DREAMHOST_WORKER_URL=https://worker.yourdomain.com
