# DaedalusSignal Frontend Environment Variables
# Copy this file to .env.local for local development
# Copy this file to .env.production for production builds

# ===================
# API Configuration
# ===================
# For local development
NEXT_PUBLIC_API_URL=http://localhost:5000

# For production (PythonAnywhere)
# Replace <username> with your PythonAnywhere username
# NEXT_PUBLIC_API_URL=https://<username>.pythonanywhere.com

# ===================
# Cloudflare Turnstile (CAPTCHA)
# ===================
# Get keys from: https://dash.cloudflare.com/turnstile
# Site key is used on the frontend, secret key is used on the backend
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ===================
# DreamHost Worker (Optional)
# ===================
# If configured, test emails will be sent via DreamHost instead of PythonAnywhere
# Leave empty to use direct PythonAnywhere email sending
# NEXT_PUBLIC_DREAMHOST_WORKER_URL=https://worker.yourdomain.com
