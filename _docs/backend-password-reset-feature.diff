+def send_password_reset_email(email: str, name: str, reset_link: str) -> bool:
+    """
+    Send a password reset magic link email.
+
+    Args:
+        email: Recipient email address
+        name: User's display name (or email if no name)
+        reset_link: The full URL with token for resetting password
+
+    Returns:
+        True if sent successfully, False otherwise
+    """
+    subject = "Reset Your DaedalusSignal Password"
+    html_content = _generate_password_reset_html(name, reset_link)
+
+    if EMAIL_MODE == 'console':
+        print("\n" + "=" * 60)
+        print(f"PASSWORD RESET EMAIL to {email}")
+        print(f"Subject: {subject}")
+        print(f"Name: {name}")
+        print(f"Reset Link: {reset_link}")
+        print(f"Expires in: 15 minutes")
+        print("=" * 60 + "\n")
+        return True
+
+    elif EMAIL_MODE == 'smtp':
+        try:
+            msg = MIMEMultipart('alternative')
+            msg['Subject'] = subject
+            msg['From'] = SMTP_FROM
+            msg['To'] = email
+
+            # Plain text fallback
+            plain_text = f"""Hi {name},
+
+We received a request to reset your DaedalusSignal password.
+
+Click this link to reset your password:
+{reset_link}
+
+This link will expire in 15 minutes.
+
+If you didn't request a password reset, you can safely ignore this email.
+
+- DaedalusSignal Team
+"""
+            msg.attach(MIMEText(plain_text, 'plain'))
+            msg.attach(MIMEText(html_content, 'html'))
+
+            with smtplib.SMTP(SMTP_HOST, SMTP_PORT) as server:
